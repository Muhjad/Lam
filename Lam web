};
function pick(o,...keys){for(const key of keys)if(o?.[key]!==undefined)return o[key];}
function normalize(raw){
 if(!raw||typeof raw!=="object"||Array.isArray(raw))throw new Error("Please upload a JSON object with a Words array.");
 const words=pick(raw,"words","Words");
 if(!Array.isArray(words)||!words.length)throw new Error('Your JSON needs a non-empty "words" (or "Words") array.');
 if(words.length>500)throw new Error("Please use 500 words or fewer per document.");
 const m=pick(raw,"metadata","Metadata")||{};
 const str=v=>typeof v==="string"||typeof v==="number"?String(v):"";
 return {
 metadata:{title:str(pick(m,"title","Title"))||"My Arabic vocabulary",arabicTitle:str(pick(m,"arabicTitle","ArabicTitle")),subtitle:str(pick(m,"subtitle","Subtitle"))||"Read, trace, and make each word your own.",lesson:str(pick(m,"lesson","Lesson"))||"Vocabulary practice",surah:str(pick(m,"surah","Surah"))},
 ayahNumber:str(pick(raw,"ayahNumber","Ayah Number","AyahNumber")),
 words:words.map((w,i)=>{
  if(!w||typeof w!=="object")throw new Error(`Word ${i+1} must be an object.`);
