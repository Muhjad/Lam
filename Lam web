       <p className="text-[11px] text-[#87907e] mt-2 mb-0">A JSON file is all you need to get started.</p>
       <div className={`dropzone ${drag?"dragging":""}`} onDragOver={e=>{e.preventDefault();setDrag(true)}} onDragLeave={()=>setDrag(false)} onDrop={e=>{e.preventDefault();setDrag(false);load(e.dataTransfer.files[0])}}>
        <input ref={input} type="file" accept=".json,application/json" aria-label="Upload vocabulary JSON file" onChange={e=>load(e.target.files[0])}/>
        <span className="text-[#668155] bg-[#e9eedf] rounded-full p-2.5 mb-3"><Icon name="upload" size={21}/></span>
        <strong className="text-[11px] font-semibold">Drop your JSON here</strong><span className="text-[10px] text-[#8c9484] mt-1">or <span className="underline underline-offset-2 text-[#526d43]">browse files</span> · up to 2 MB</span>
       </div>
       {error&&<p role="alert" className="text-red-700 text-xs mt-3">{error}</p>}
       <div className="file-line" role="status"><Icon name="file" size={17}/><div className="min-w-0 flex-1"><div className="truncate font-medium">{fileName}</div><div className="text-[9px] text-[#89967c] mt-0.5">{data.words.length} words · {data.sentences.length} sentences</div></div><span className="text-[#71894f]"><Icon name="check" size={14}/></span></div>
       <div className="mt-4 flex items-center justify-between"><span className="text-[10px] text-[#929888]">Need a starting point?</span><button className="text-button" onClick={downloadSample}>Get sample JSON</button></div>
      </div>
      <div className="setting-block">
       <h2 className="text-[13px] font-bold m-0 flex items-center"><span className="step-number">02</span> Choose your format</h2>
       <label htmlFor="template" className="block text-[10px] text-[#85907c] mt-5 mb-2">Print template</label>
       <div className="relative"><select id="template" className="template-select" value={template} onChange={e=>setTemplate(e.target.value)}>{Object.entries(templates).map(([k,t])=><option value={k} key={k}>{t.name}</option>)}</select><span className="absolute right-3 top-3 pointer-events-none text-[#7f8d73]"><Icon name="chevron" size={17}/></span></div>
       <div className="spec-grid"><div><span>Paper size</span><strong>{spec.dimensions}</strong></div><div><span>Safe margin</span><strong>{spec.margin}</strong></div></div>
       <div className="mt-4 flex gap-2 text-[10px] leading-relaxed text-[#819273]"><Icon name="info" size={13} className="shrink-0 mt-0.5"/><span>{spec.description}</span></div>
      </div>
      <div className="setting-block" style={{borderBottom:0}}>
       <h2 className="text-[13px] font-bold m-0 flex items-center mb-5"><span className="step-number">03</span> Make it tangible</h2>
       <button className="primary" onClick={print} disabled={busy}><Icon name="print" size={17}/>{busy?"Preparing your pages…":"Generate PDF"}<span className="ml-auto opacity-70">↗</span></button>
       <p className="text-center text-[9px] text-[#929988] mb-0 mt-3">Choose “Save as PDF” in your print dialog.</p>
      </div>
     </div>
     <div className="tip"><span className="text-[#8b9b76] mt-0.5 shrink-0"><Icon name="info" size={16}/></span><div><strong className="font-medium text-[#647854]">A small print tip</strong><br/>Use 100% scale and turn off headers & footers. We've taken care of the margins.</div></div>
    </aside>
    <section className="preview-panel" aria-label="Live preview">
     <div className="preview-toolbar no-print">
      <div className="flex items-center gap-2.5"><Icon name="eye" size={17}/><h2 className="text-[12px] font-semibold m-0">Live preview</h2><span className="text-[8px] tracking-wide bg-[#edf2e4] text-[#768d5d] px-2 py-1 rounded-full hidden sm:inline">READY TO PRINT</span></div>
      <div className="flex items-center gap-3"><span className="text-[10px] text-[#8c9484] hidden md:inline">{template==="binder"?"A5":template==="sticker"?"A4":"A6"} · Portrait</span><span className="w-px h-4 bg-[#e1e5d8]"/><label className="sr-only" htmlFor="zoom">Preview zoom</label><select id="zoom" value={zoom} onChange={e=>setZoom(Number(e.target.value))} className="text-[10px] text-[#6b795e] border-0 bg-transparent cursor-pointer"><option value={65}>65%</option><option value={85}>85%</option><option value={100}>100%</option></select></div>
     </div>
     <div className="preview-canvas" ref={canvas}>
      <div className="page-frame" ref={paper} style={{width:spec.width*96/25.4*fit,height:height*fit}}>
       <div style={{transform:`scale(${fit})`,transformOrigin:"top left"}}><Sheet data={data} template={template}/></div>
      </div>
      <div className="no-print text-center text-[9px] text-[#87927c] mt-6 tracking-wide">REAL DIMENSIONS. LITTLE DETAILS. READY FOR PAPER.</div>
     </div>
    </section>
   </div>
  </main>
  <footer className="shell no-print mt-9"><div className="footer-inner border-t border-[#dfe3d6] py-5 flex justify-between text-[10px] text-[#929989]"><span>Rumah Lam PDF Generator <span className="mx-2 text-[#c1c7b8]">/</span> A little care in every page.</span><span className="flex items-center gap-2">Made for learning, not collecting data. <span className="text-[#839869]">✳</span></span></div></footer>
  <dialog ref={dialog}>
   <div className="flex justify-between items-center mb-4"><h2 className="text-xl font-bold m-0">From words to worksheets.</h2><button aria-label="Close instructions" onClick={()=>dialog.current.close()} className="border-0 bg-transparent p-2"><Icon name="close"/></button></div>
   <p className="text-sm leading-relaxed text-[#75816c]">Upload your JSON, choose a paper format, then select <strong>Generate PDF</strong>. In the print dialog, use “Save as PDF”, 100% scale, and disable browser headers and footers.</p>
   <h3 className="text-sm font-bold mt-5">JSON structure</h3>
   <pre>{JSON.stringify({metadata:{title:"My vocabulary",arabicTitle:"كَلِمَاتِي",surah:"Al-Fatihah"},ayahNumber:1,words:[{arabic:"بِسْمِ",trace:"بِسْ_",meaning:"In the name of",category:"Phrase",shape:"circle"}],sentences:[{arabic:"بِسْمِ اللَّهِ",translation:"In the name of Allah"}]},null,2)}</pre>
   <p className="text-xs leading-relaxed text-[#75816c]">In <strong>trace</strong>, replace target letters with <strong>_</strong>, <strong>...</strong>, or <strong>…</strong> to create dotted writing spaces. Other characters are preserved. Sticker shapes accept <strong>circle</strong> or <strong>square</strong>. Capitalized keys such as <strong>Metadata</strong>, <strong>Words</strong>, and <strong>Ayah Number</strong> are also supported.</p>
   <button className="primary mt-4" onClick={downloadSample}>Download sample JSON <Icon name="file" size={16}/></button>
  </dialog>
 </>
}
ReactDOM.createRoot(document.getElementById("root")).render(<App/>);
</script>
</body>
</html>
 
