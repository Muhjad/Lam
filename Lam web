 }),
 sentences:(Array.isArray(pick(raw,"sentences","Sentences"))?pick(raw,"sentences","Sentences"):[]).map(s=>typeof s==="string"?{arabic:s,translation:""}:{arabic:str(pick(s,"arabic","Arabic","sentence","Sentence")),translation:str(pick(s,"translation","Translation","meaning","Meaning"))})
 };
}
