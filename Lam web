const sample={
 metadata:{title:"Little words. Big beginnings.",arabicTitle:"كَلِمَاتِي الْأُولَى",subtitle:"Read, trace, and make each word your own.",lesson:"Everyday essentials",surah:"Al-Fatihah"},
