    @media(max-width:760px){.shell{padding:0 20px}.header{height:72px}.workspace{grid-template-columns:1fr}.preview-canvas{min-height:500px}.desktop-nav{display:none}.intro{flex-direction:column;align-items:flex-start!important;gap:14px}.setting-block{padding:22px}.settings{display:grid;grid-template-columns:1fr}.preview-toolbar{padding:14px}.footer-inner{flex-direction:column;gap:10px}}
    @media(prefers-reduced-motion:reduce){*{animation:none!important;transition:none!important}}
