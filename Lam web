      .paper{transform:none!important;width:auto!important;min-height:0!important;padding:0!important;box-shadow:none!important;background:white!important;overflow:visible!important}
      .paper:before,.punches{display:none!important}
      .word-row,.sentence-box,.sticker-item{break-inside:avoid;page-break-inside:avoid}
      .worksheet-heading{break-after:avoid}
      *{-webkit-print-color-adjust:exact;print-color-adjust:exact}
    }
